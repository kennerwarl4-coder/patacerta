# =====================================================================
# LofyPay - Variáveis de Ambiente (Configure no painel da Vercel)
# =====================================================================
#
# Para Produção: use sk_live_...
# Para Sandbox (Testes): use sk_test_...
#
LOFYPAY_SECRET_KEY=sk_live_SUBSTITUA_PELA_SUA_CHAVE_AQUI
LOFYPAY_PUBLIC_KEY=pk_live_SUBSTITUA_PELA_SUA_PUBLIC_KEY_AQUI

# Secret do Webhook (obtido no painel da LofyPay em Gateway/API > Webhooks):
# Endpoint: https://pata-five.vercel.app/api/webhook
LOFYPAY_WEBHOOK_SECRET=COLE_AQUI_O_SECRET_DO_WEBHOOK
